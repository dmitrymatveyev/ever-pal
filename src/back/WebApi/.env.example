# Copy this file to .env and fill in your actual values

# Firebase Configuration
# Get these from: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
# FIREBASE_CREDENTIALS should contain the entire JSON content of your service account key (single line)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}
# Get API key from: https://console.firebase.google.com/project/_/settings/general (Web API Key)
FIREBASE_API_KEY=AIzaSy...

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_xxxxx

# SSL Certificate (for local HTTPS)
Development_SSL_Certificate_Password=your_cert_password
